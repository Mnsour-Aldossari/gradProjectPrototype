<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_landmine_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 side of the UAV landmine detection prototype: a bridge that publishes a mission from the backend (position, readings, detections) the project's adaptive detector as a node, commands through the backend, and a direct reader of PX4. Simulated data; every output is a potential detection.</description>
  <maintainer email="noreply@example.invalid">UAV-Based Landmine Detection System team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>uav_landmine_interfaces</exec_depend>
  <!-- px4_link only: PX4's messages, built by ros2_ws/build.sh (px4_msgs at PX4's version) -->
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
