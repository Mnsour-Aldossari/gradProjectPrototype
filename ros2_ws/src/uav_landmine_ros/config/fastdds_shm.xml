<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS over shared memory only: the nodes of one machine (one WSL distribution) talk to each other without the
     network. On the development PC (WSL 2 with mirrored networking) Fast DDS's UDP path delivered nothing between
     processes, while shared memory did. landmine.launch.py uses it unless FASTRTPS_DEFAULT_PROFILES_FILE is set;
     ros2_ws/env.sh sets it for other terminals (ros2 topic echo, ros2 bag). Nodes on other machines cannot join. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shared_memory</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shared_memory_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shared_memory</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
